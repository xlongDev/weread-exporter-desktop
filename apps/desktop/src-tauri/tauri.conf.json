{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeRead Exporter",
  "version": "0.1.9",
  "identifier": "com.weread.exporter.desktop",
  "build": {
    "beforeDevCommand": "bash ../../scripts/prepare-runtime.sh && pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash ../../scripts/prepare-runtime.sh && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WeRead Exporter",
        "width": 1080,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://res.weread.qq.com https://pica.zhimg.com https://*.image.myqcloud.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$DATA/weread-exporter/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/engine": "engine",
      "resources/runtime": "runtime"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4ODY1ODUwREYyMDc2RDIKUldUU2RpRGZVRmlHeU55MzlUSFJSd0pGT2U4Z1FDa3hLUVQydGxYbkx5bE8yaWQ5aW5YaXFoTzcK",
      "endpoints": [
        "https://github.com/xlongDev/weread-exporter-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
